# Copy to .env for local development. In production set these on the host.

# Database (production uses DATABASE_URL; dev/test use config/database.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mechanicai_backend_development

# Auth — long random value, e.g. `openssl rand -hex 64`. Rotating it signs everyone out.
JWT_SECRET=
# Public URL of the Next.js app; used for email links.
FRONTEND_URL=http://localhost:3000
# Run the API on 3001 locally (PORT=3001) so it does not clash with Next.js.
# Comma-separated hostnames this API answers to (production Host header check).
API_HOST=api.example.com

# Shared with the frontend so the API can trust the forwarded client IP for rate limiting.
INTERNAL_API_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_PRO=gpt-5.4-mini
OPENAI_MODEL_FREE=gpt-5.4-nano
# Optional: "low" keeps reasoning models from spending the token budget on reasoning.
# OPENAI_REASONING_EFFORT=low
# Optional: OpenAI-compatible endpoint (proxy, Azure, local mock).
# OPENAI_URI_BASE=https://api.openai.com/

# Email (Resend)
RESEND_API_KEY=
SUPPORT_EMAIL=support@example.com

# Paddle Billing — webhook destination: https://<API_HOST>/pay/webhooks/paddle_billing
PADDLE_BILLING_ENVIRONMENT=sandbox
PADDLE_BILLING_API_KEY=
PADDLE_BILLING_CLIENT_TOKEN=
PADDLE_BILLING_SIGNING_SECRET=

# Run Solid Queue (email delivery) inside the web process.
SOLID_QUEUE_IN_PUMA=1
